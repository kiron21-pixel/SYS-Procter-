<!--
  WiX Toolset v5 MSI for Windows 10/11 (x64 and arm64). NOT YET BUILT OR TESTED: see docs/PLATFORM_STATUS.md.
  Installs only into Program Files\AI Laptop Guardian plus Start menu and desktop shortcuts. No services, drivers,
  scheduled tasks, firewall rules or changes to other software. Uninstalling removes exactly what was installed;
  per-user data in %LOCALAPPDATA%\AI Laptop Guardian is kept (see docs/INSTALL.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AI Laptop Guardian" Manufacturer="AI Laptop Guardian" Version="$(var.Version)"
           UpgradeCode="F0783A61-1612-4573-93B0-B30AD4B9C571" Scope="perMachine" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of AI Laptop Guardian is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="GuardianIcon" SourceFile="$(var.RepoRoot)\assets\brand\guardian.ico" />
    <Property Id="ARPPRODUCTICON" Value="GuardianIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AI Laptop Guardian" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="GuardianShortcut" Name="AI Laptop Guardian" Description="Security and maintenance status (Observe Only by default)"
                  Target="[INSTALLFOLDER]ai-laptop-guardian.exe" WorkingDirectory="INSTALLFOLDER" Icon="GuardianIcon" />
        <RegistryValue Root="HKLM" Key="Software\AI Laptop Guardian" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="GuardianDesktopShortcut" Name="AI Laptop Guardian" Description="Security and maintenance status (Observe Only by default)"
                  Target="[INSTALLFOLDER]ai-laptop-guardian.exe" WorkingDirectory="INSTALLFOLDER" Icon="GuardianIcon" />
        <RegistryValue Root="HKLM" Key="Software\AI Laptop Guardian" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="AI Laptop Guardian" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
